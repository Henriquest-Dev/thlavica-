# Domínio final (sem barra no fim). Necessário para sitemap.xml e URLs canónicos/Open Graph.
VITE_SITE_URL=

# Envio de formulários:
#   netlify  -> Netlify Forms (requer alojamento na Netlify; os formulários estáticos estão em index.html)
#   endpoint -> POST JSON para VITE_FORM_ENDPOINT (ex.: Formspree, Getform, API própria)
#   (vazio)  -> envio desativado; o site mostra que o envio não está configurado e sugere WhatsApp/email
VITE_FORM_MODE=netlify
VITE_FORM_ENDPOINT=

# Mostrar especificações transcritas de anúncios que ainda não foram validadas (true/false).
# Aparecem sempre marcadas "por validar". Pôr a false para esconder até à validação.
VITE_SHOW_UNVERIFIED_SPECS=true
